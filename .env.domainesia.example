# =====================================================================
# Template `.env` — DomaiNesia (shared hosting / cPanel) — sik-kppd.com
# =====================================================================
#
# Cara pakai:
#   1. Salin file ini menjadi `.env` di root proyek pada server
#      (`cp .env.domainesia.example .env`).
#   2. Isi bagian yang ditandai <<< ISI >>> — kredensial database dari
#      cPanel → MySQL Databases (§2 PANDUAN_INSTALASI_SHARED_HOSTING.md).
#   3. Generate APP_KEY: `php artisan key:generate`
#      (atau biarkan kosong dan pakai wizard `/install`, yang mengisinya
#      otomatis — lihat PANDUAN_DEPLOY_DOMAINESIA.md §7).
#
# CATATAN PENTING — profil ini sengaja BERBEDA dari
# `.env.production.example`. File itu ditulis untuk deployment container
# (Redis + S3 + Horizon). Shared hosting DomaiNesia tidak punya ketiganya,
# jadi di sini semua driver diarahkan ke `database`/`local`.
#
# JANGAN commit file `.env` yang sudah terisi ke git — sudah di-ignore.

APP_NAME="Koperasi Sejahtera Bersama"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sik-kppd.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# `file` (bukan `cache`) — driver maintenance berbasis cache butuh store
# yang sudah siap sebelum framework boot; di shared hosting `file` lebih aman.
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `daily` supaya log dirotasi otomatis — kuota disk shared hosting terbatas
# dan `single` akan menumbuhkan satu file laravel.log tanpa batas.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (cPanel → MySQL Databases) --------------------------------
# Nama database & user di cPanel selalu berprefix username cPanel,
# contoh: `sikkppd_koperasi` dan `sikkppd_admin`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=            # <<< ISI >>>
DB_USERNAME=            # <<< ISI >>>
DB_PASSWORD=            # <<< ISI >>>

# --- Session ------------------------------------------------------------
# `database`, bukan `redis`: shared hosting DomaiNesia tidak menyediakan
# Redis. Tabel `sessions` dibuat oleh migrasi (§7).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Wajib true setelah SSL aktif (PANDUAN_DEPLOY_DOMAINESIA.md §6). Kalau SSL
# belum terbit, set false SEMENTARA — kalau tidak, cookie sesi tidak akan
# pernah terkirim dan login gagal diam-diam tanpa pesan error.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
# Jangan ubah — lihat penjelasan di `.env.example`.
SESSION_COOKIE=koperasi_session

BROADCAST_CONNECTION=log

# `public` — dokumen/foto anggota disimpan di disk lokal server, bukan S3.
# Disk ini sudah diset `serve => true` di config/filesystems.php sehingga
# file tetap terlayani lewat PHP walau hosting memblokir symlink().
FILESYSTEM_DISK=public

# `database` — antrian diproses cron tiap menit (§8), bukan Horizon.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Email (cPanel → Email Accounts) ------------------------------------
# Buat dulu akun email di cPanel, lalu isi kredensialnya di sini.
# Host mail DomaiNesia umumnya `mail.<domain>`; kalau ditolak, pakai
# hostname server yang tertera di cPanel → General Information.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.sik-kppd.com
MAIL_PORT=465
MAIL_USERNAME=          # <<< ISI >>> mis. noreply@sik-kppd.com
MAIL_PASSWORD=          # <<< ISI >>>
MAIL_FROM_ADDRESS="noreply@sik-kppd.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Integrasi opsional -------------------------------------------------
# Semua blok di bawah boleh dibiarkan kosong. Aplikasi mendeteksi sendiri
# dan menonaktifkan fitur terkait (bukan error).

# WhatsApp Business API (PRD §16) — kosong = notifikasi fallback ke Email.
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=

# Xendit — kosong = tombol pembayaran mandiri disembunyikan di Portal Anggota.
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=
