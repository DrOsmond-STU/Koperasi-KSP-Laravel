# Template variabel lingkungan PRODUKSI (07_DEPLOYMENT.md §3/§10).
#
# Ini BUKAN file `.env` produksi yang sesungguhnya — nilai rahasia di sini
# hanyalah placeholder. Nilai asli berasal dari Vault/KMS dan disuntikkan
# sebagai environment variable saat deploy (container), TIDAK PERNAH dari
# file `.env` yang tersimpan di server atau di-commit ke repo.
# Gunakan file ini sebagai daftar variabel yang wajib tersedia di lingkungan
# `staging`/`production`, bukan sebagai sumber nilai.

APP_NAME="Koperasi Sejahtera Bersama"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://koperasi.example.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=cache

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# HTTPS wajib di produksi (TLS 1.2+/HSTS — DEPLOYMENT.md §3): paksa cookie
# sesi hanya dikirim lewat koneksi terenkripsi.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# predis/predis — no phpredis PHP extension required.
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Provider email produksi (bukan `log`) — kredensial dari Vault/KMS.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@koperasi.example.id"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage S3-compatible (DEPLOYMENT.md §2) — dokumen anggota &
# dokumen kepemilikan aktiva tetap, terenkripsi di sisi provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Horizon — dashboard queue worker, digerbang lewat gate
# `viewHorizon` (role admin_sistem). HORIZON_DOMAIN/PATH opsional.
HORIZON_PATH=horizon

# WhatsApp Business API (PRD §16) — kredensial produksi resmi (BSP/Meta),
# terpisah dari nomor uji sandbox development/staging. Template pesan wajib
# sudah disetujui BSP/Meta sebelum go-live (DEPLOYMENT.md §3).
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
